# Resend API key for sending contact form emails
RESEND_API_KEY=re_your_api_key_here

# Email address to send contact form submissions from
RESEND_FROM_EMAIL=onboarding@resend.dev

# Email address to receive contact form submissions
CONTACT_EMAIL=info@valueplusegypt.com

# Path to the SQLite database file used by the admin/CRM backend
DATABASE_PATH=./data/crm.db

# Credentials for the initial admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@valueplusegypt.com
SEED_ADMIN_PASSWORD=change-me-before-deploying
